# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every variable below is read by code in this repo — nothing here is decorative.

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/moviemotions

# ─── AWS / Bedrock ────────────────────────────────────────────────────
# boto3 picks these up on its own; no code reads the key or secret directly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Embeddings. NOVA is the model in use.
BEDROCK_MODEL_EMBED_NOVA=
# TITAN is only needed by the two-model comparison in experiments/.
# Those scripts read it with os.environ[...] and will crash without it.
BEDROCK_MODEL_EMBED_TITAN=

# Text generation. Also the agent's model unless BEDROCK_MODEL_AGENT is set.
BEDROCK_MODEL_TEXT=
# Optional. The seam for swapping the agent's model without touching code.
BEDROCK_MODEL_AGENT=

# Only used by experiments/rerank_smoke_test.py (Bedrock-native reranking).
# Leave blank unless you run that script.
BEDROCK_RERANK_MODEL=

# ─── OpenRouter — reranker and eval judge ─────────────────────────────
OPENROUTER_API_KEY=
RERANK_MODEL=cohere/rerank-v3.5
# The RAGAS faithfulness judge. Deliberately NOT the model under test.
RAGAS_JUDGE_MODEL=google/gemini-3.5-flash-lite

# ─── TMDB — only needed to rebuild the catalogue from scratch ─────────
TMDB_READ_TOKEN=

# ─── LangSmith — optional tracing ─────────────────────────────────────
# The SDK reads LANGSMITH_API_KEY itself; the other two are read by our code.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=moviemotions
