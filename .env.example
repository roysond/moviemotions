# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# THIS FILE AND .env HOLD THE SAME VARIABLE NAMES, IN THE SAME ORDER.
# Every name below is read by code in this repository — the list was generated
# by scanning for os.environ, not typed from memory. Nothing here is decorative.
#
# A COMMENTED-OUT LINE IS NOT THE SAME AS A BLANK ONE.
# Optional settings are commented out on purpose. os.environ.get(NAME, default)
# returns the DEFAULT when the name is absent and returns "" when the name is
# present and empty — so writing `BEDROCK_MODEL_AGENT=` would hand the agent an
# empty model id and break it. Uncomment only to override.

# ══════════════════════════════════════════════════════════════════════════════
#  EVERY MODEL THIS APPLICATION USES
#  Read this first. It answers "what are we running, and what does it do?"
#  without opening a single Python file.
#
#  VARIABLE                    MODEL                                     WHAT IT DOES                                              CALLED FROM
#  ─────────────────────────── ───────────────────────────────────────── ───────────────────────────────────────────────────────── ──────────────────────────────────
#  BEDROCK_MODEL_EMBED_NOVA    amazon.nova-2-multimodal-embeddings-v1:0  Turns text into numbers so search can compare MEANING      backend/models.py  -> embed()
#                                                                        rather than words. Runs on the corpus at build time
#                                                                        and on every question asked. LIVE.
#
#  BEDROCK_MODEL_TEXT          amazon.nova-micro-v1:0                    THE AGENT'S BRAIN. Chooses which tool to use, writes       backend/agent.py
#                                                                        its arguments, then writes the final answer. The SAME      pipeline/derive_corpus.py
#                                                                        model also writes each film's mood text at build
#                                                                        time. LIVE.
#
#  BEDROCK_MODEL_AGENT         (not set)                                 OPTIONAL OVERRIDE. If set, the AGENT uses this and         backend/agent.py
#                                                                        BEDROCK_MODEL_TEXT keeps its build-time job. This is
#                                                                        the seam for changing the agent's model alone.
#
#  RERANK_MODEL                cohere/rerank-v3.5                        Re-reads the ~30 candidate passages against the            backend/models.py  -> rerank()
#                                                                        question and reorders them. Reads query and text
#                                                                        TOGETHER, which is how it tells "creatures hunting
#                                                                        people" from "a tiger in the bathroom". LIVE.
#
#  VERTEX_MODEL_AGENT          gemini-3.8-flash                          Second provider, on Google instead of AWS. NOT WIRED       experiments/vertex_smoke.py
#                                                                        INTO THE APP YET — only the smoke test calls it.
#
#  RAGAS_JUDGE_MODEL           openai/gpt-5.6-luna                       Grades how well answers stick to the retrieved text.       evals/eval_agent.py
#                                                                        TESTING ONLY, never runs for a real user. Deliberately
#                                                                        not the model being tested.
#
#  BEDROCK_MODEL_EMBED_TITAN   (not set)                                 DEAD. An old two-model embedding comparison.               experiments/ only
#  BEDROCK_RERANK_MODEL        (not set)                                 DEAD. An old Bedrock-native rerank test.                   experiments/ only
#
#  NOT A MODEL, BUT WORTH KNOWING: three of the agent's four tools call NO model at
#  all. lookup_film, find_films_by_fact and check_availability are pure database
#  queries. Only search_films touches the embedder and the reranker.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────
# read by: backend/config.py, backend/providers.py, pipeline/*
DATABASE_URL=postgresql://user:password@localhost:5432/moviemotions

# ─── AWS / Bedrock ────────────────────────────────────────────────────
# boto3 reads the key and secret itself; no code in this repo touches them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# read by: backend/config.py, backend/agent.py, pipeline/derive_corpus.py
AWS_REGION=us-east-1

# Embeddings, live. read by: backend/config.py
BEDROCK_MODEL_EMBED_NOVA=
# Text generation at build time, AND the agent's model unless the next line is set.
# read by: backend/agent.py, pipeline/derive_corpus.py
BEDROCK_MODEL_TEXT=

# OPTIONAL — override the agent's model without touching code.
# read by: backend/agent.py
#BEDROCK_MODEL_AGENT=
# OPTIONAL — only experiments/embed_compare.py and search_compare.py.
#BEDROCK_MODEL_EMBED_TITAN=
# OPTIONAL — only experiments/rerank_smoke_test.py (Bedrock-native reranking).
#BEDROCK_RERANK_MODEL=

# ─── GCP / Vertex AI — second LLM provider ────────────────────────────
# Google renamed the product to "Gemini Enterprise Agent Platform" in 2026. The
# API, the SDKs and these names still say vertex/aiplatform, so the code follows
# the library rather than the brochure.
#
# THERE IS NO KEY HERE, and that is the point. Credentials come from Application
# Default Credentials, written OUTSIDE this project by:
#     gcloud auth application-default login
# Compare with the AWS block above, where a key and secret sit in this file.
# read by: experiments/vertex_smoke.py
GCP_PROJECT=
# `global`, not a region. Current Gemini models are served from one global
# endpoint; us-central1 returns 404 for them. Measured 2 Sep 2026.
GCP_LOCATION=global
VERTEX_MODEL_AGENT=gemini-3.8-flash

# ─── OpenRouter — reranker and eval judge ─────────────────────────────
# read by: backend/config.py, evals/eval_agent.py
OPENROUTER_API_KEY=
RERANK_MODEL=cohere/rerank-v3.5

# OPTIONAL — the RAGAS faithfulness judge, deliberately NOT the model under test.
# Changing it re-baselines the score; scores from different judges do not compare.
# read by: evals/eval_agent.py
#RAGAS_JUDGE_MODEL=openai/gpt-5.6-luna
# OPTIONAL — draws per case. The judge disagrees with itself, so one draw is not
# a measurement. 3 brings the headline to +/- 0.02. Must be an integer if set.
#RAGAS_JUDGE_REPEATS=3

# ─── TMDB — only needed to rebuild the catalogue from scratch ─────────
# read by: pipeline/fetch_titles.py
TMDB_READ_TOKEN=

# ─── LangSmith — tracing ──────────────────────────────────────────────
# read by: backend/api.py (the SDK reads LANGSMITH_API_KEY itself)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=moviemotions

# ─── Diagnostics ──────────────────────────────────────────────────────
# OPTIONAL — which stored embedding variant experiments/why_chunk.py inspects.
# Must match what production searches, or its verdicts describe a pool that
# does not exist.
#WHY_VARIANT=context_header
